# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API Keys > service_role (server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform (Maps JavaScript API + Places API + Geocoding API を有効化したキー)
# ブラウザの地図表示にも、サーバー側のお店データ同期にも同じキーを使います。
# GCPコンソールでHTTPリファラー制限をかけて公開しても問題ないようにしてください。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
